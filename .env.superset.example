# Copy this file to .env.superset before starting Superset.
# Replace every secret in a production deployment.
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
GUEST_TOKEN_JWT_SECRET=replace-with-a-different-long-random-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@ledgerflow.local
