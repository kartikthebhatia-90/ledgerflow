# -----------------------------------------------------------------------------
# LedgerFlow application
# -----------------------------------------------------------------------------
APP_NAME=LedgerFlow
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
APP_TIMEZONE=Australia/Melbourne
MAX_UPLOAD_MB=100
SUPER_GUARANTEE_RATE=0.12

# Optional local OCR for scanned/image-only PDFs. Install Tesseract separately.
OCR_ENABLED=true
OCR_MAX_PAGES=8
OCR_DPI=180
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# -----------------------------------------------------------------------------
# Primary AI provider: NVIDIA NIM API
# Create a key in the NVIDIA API Catalog and paste it only into your local .env.
# Never commit the real key.
# -----------------------------------------------------------------------------
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
MODEL_CONTEXT_SIZE=8192
MODEL_MAX_OUTPUT_TOKENS=420
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=35

# -----------------------------------------------------------------------------
# Optional local/offline fallback
# Set MODEL_PROVIDER=ollama and OLLAMA_ENABLED=true to use it as primary.
# -----------------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_KEEP_ALIVE=30m

# -----------------------------------------------------------------------------
# Prompt token reduction layer
# budgeted = dependency-free deterministic context selection
# llmlingua = optional Microsoft LLMLingua-2 GitHub integration
# Install: pip install -r backend/requirements-llmlingua.txt
# -----------------------------------------------------------------------------
PROMPT_COMPRESSION_ENABLED=true
PROMPT_COMPRESSION_PROVIDER=budgeted
PROMPT_COMPRESSION_TARGET_RATIO=0.55
PROMPT_COMPRESSION_MIN_CHARS=4500
PROMPT_COMPRESSION_MAX_CHARS=18000
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

# -----------------------------------------------------------------------------
# Durable agent identity and clearable working context
# -----------------------------------------------------------------------------
AGENT_BASE_PERSONALITY_FILE=./agent/BASE_PERSONALITY.md
AGENT_CONTEXT_MAX_EVENTS=36
AGENT_CONTEXT_MAX_CHARS=14000
AGENT_AUTONOMY_LEVEL=2
AGENT_MAX_STEPS=15
# hybrid = deterministic routine tasks + NVIDIA for open-ended reasoning
AGENT_AI_ROUTING_MODE=hybrid
REQUIRE_APPROVAL_FOR_WRITES=true
ALLOW_TERMINAL_TOOL=false

# -----------------------------------------------------------------------------
# Embedded data / background processing
# -----------------------------------------------------------------------------
VALIDATION_INTERVAL_MINUTES=15
MEMORY_RECENT_MESSAGES=12
MEMORY_COMPACTION_THRESHOLD=40
DUCKDB_CONNECT_RETRIES=5
DUCKDB_RETRY_DELAY_SECONDS=0.35

# -----------------------------------------------------------------------------
# Optional web research
# -----------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=none
SEARXNG_URL=http://127.0.0.1:8080
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional secondary OpenAI-compatible fallback (off by default)
CLOUD_FALLBACK_ENABLED=false
CLOUD_PROVIDER=
CLOUD_MODEL=
CLOUD_BASE_URL=
CLOUD_API_KEY=

# Project-folder file intake
FOLDER_INTAKE_ENABLED=true
FOLDER_INTAKE_DIR=./data/source_files
FOLDER_INTAKE_SCAN_SECONDS=5


# LangGraph departmental multi-agent orchestration
LANGGRAPH_ENABLED=true
LANGGRAPH_STRICT_MSGPACK=true
LANGGRAPH_MAX_DEPARTMENT_AGENTS=4

# Apache Superset embedded analytics (Docker service on port 8088)
SUPERSET_ENABLED=true
SUPERSET_DOMAIN=http://127.0.0.1:8088
SUPERSET_VERIFY_SSL=false
SUPERSET_SERVICE_USERNAME=admin
SUPERSET_SERVICE_PASSWORD=change-me
# Paste the embedded dashboard UUID created in Superset for each department.
SUPERSET_DASHBOARD_EXECUTIVE_UUID=
SUPERSET_DASHBOARD_FINANCE_UUID=
SUPERSET_DASHBOARD_TAX_UUID=
SUPERSET_DASHBOARD_MARKETING_UUID=
SUPERSET_DASHBOARD_OPERATIONS_UUID=
SUPERSET_DASHBOARD_PEOPLE_UUID=
SUPERSET_DASHBOARD_MARKET_UUID=
